@model Category
<div class="container">
    <div class="text-center bg-dark">
        <h2 class="text-white">
            Edit Category
        </h2>
    </div>
    <form method="post">
        <div>
            <label class="col-form-label mt-4" for="inputDefault">Category Name</label>
            <input asp-for="Name" class="form-control" id="inputDefault">
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div>
            <label class="col-form-label mt-4" for="inputDefault">Display Order</label>
            <input asp-for="DisplayOrder" class="form-control" id="inputDefault">
            <span asp-validation-for="DisplayOrder" class="text-danger"></span>
        </div>
        <div class="row pt-4">
            <div class="col-6 pt-3">
                <button type="submit" class="btn btn-primary bg-danger form-control" style="width: full;">Edit</button>
            </div>
            <div class="col-2 bg-primary">
                <a asp-controller="Category" asp-action="Index" class="btn btn-primary">
                    BACK TO LIST
                </a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}