@model Product
<div class="container">
    <div class="text-center bg-dark">
        <h2 class="text-white">
            Edit Product
        </h2>
    </div>
    <form method="post">
        <div>
            <label class="col-form-label mt-4" for="inputDefault">Product Title</label>
            <input asp-for="Title" class="form-control" id="inputDefault">
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>
        <div>
            <label class="col-form-label mt-4" for="inputDefault">Discription</label>
            <input asp-for="Discription" class="form-control" id="inputDefault">
            <span asp-validation-for="Discription" class="text-danger"></span>
        </div>
        <div>
            <label class="col-form-label mt-4" for="inputDefault">Author</label>
            <input asp-for="Author" class="form-control" id="inputDefault">
            <span asp-validation-for="Author" class="text-danger"></span>
        </div>
        <div>
            <label class="col-form-label mt-4" for="inputDefault">ISBN</label>
            <input asp-for="ISBN" class="form-control" id="inputDefault">
            <span asp-validation-for="ISBN" class="text-danger"></span>
        </div>
        <div>
            <label class="col-form-label mt-4" for="inputDefault">List Price</label>
            <input asp-for="ListPrice" class="form-control" id="inputDefault">
            <span asp-validation-for="ListPrice" class="text-danger"></span>
        </div>
        <div>
            <label class="col-form-label mt-4" for="inputDefault">Price for 1-50</label>
            <input asp-for="Price" class="form-control" id="inputDefault">
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>
        <div>
            <label class="col-form-label mt-4" for="inputDefault">Price for 50+</label>
            <input asp-for="Price50" class="form-control" id="inputDefault">
            <span asp-validation-for="Price50" class="text-danger"></span>
        </div>
        <div class="row pt-4">
            <div class="col-6 pt-3">
                <button type="submit" class="btn btn-primary bg-danger form-control" style="width: full;">Edit</button>
            </div>
            <div class="col-2 bg-primary">
                <a asp-controller="Product" asp-action="Index" class="btn btn-primary">
                    BACK TO LIST
                </a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}